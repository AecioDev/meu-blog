---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

/**
 * Formulário só de interface — ainda não envia nada.
 *
 * ────────────────────────────────────────────────────────────────
 * COMO LIGAR O ENVIO DEPOIS (mantendo o site estático):
 *  • Formspree:  <form action="https://formspree.io/f/SEU_ID" method="POST">
 *  • Web3Forms:  <form action="https://api.web3forms.com/submit" method="POST">
 *                + <input type="hidden" name="access_key" value="SUA_CHAVE">
 *  • Vercel Function: mude o output do Astro para 'server' com o adapter
 *    da Vercel e crie um endpoint em src/pages/api/contato.ts.
 *
 * Ao ligar de verdade: remova o `data-contato` (e o script no fim do
 * arquivo) para o navegador voltar a enviar o formulário normalmente.
 * ────────────────────────────────────────────────────────────────
 */

const assuntos = [
  'Tenho uma dúvida sobre um tutorial',
  'Quero sugerir um tema',
  'Achei um erro no site',
  'Proposta de parceria ou publicidade',
  'Outro assunto',
];
---

<BaseLayout
  title="Contato"
  description="Dúvida, sugestão de pauta ou parceria? Fala com a equipe do Crescendo na Obra."
  comSidebar={false}
>
  <div class="mx-auto max-w-2xl">
    <Breadcrumb itens={[{ titulo: 'Início', href: '/' }, { titulo: 'Contato' }]} />

    <header class="mt-5">
      <h1 class="font-titulo text-3xl font-bold sm:text-4xl">
        Fala com a gente <span aria-hidden="true">💬</span>
      </h1>
      <p class="mt-3 text-lg text-tinta-suave">
        Travou no meio de um conserto? Quer sugerir um tema? Manda aqui. A gente
        lê tudo e responde o que dá.
      </p>
    </header>

    <div
      class="mt-6 rounded-2xl border-2 border-dashed border-obra-300 bg-obra-50 p-4 text-sm text-tinta-suave"
      role="note"
    >
      <strong class="text-tinta">Heads up:</strong> este formulário ainda é só a
      interface — o envio será ligado em breve. Por enquanto, nada é enviado de
      verdade.
    </div>

    <form
      class="mt-8 flex flex-col gap-5 rounded-2xl border-2 border-borda bg-papel p-6 sm:p-8"
      data-contato
    >
      <div class="flex flex-col gap-1.5">
        <label for="nome" class="font-titulo font-semibold text-tinta">
          Como te chamamos? <span class="text-tijolo-700" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="nome"
          name="nome"
          required
          autocomplete="name"
          placeholder="Seu nome ou apelido"
          class="rounded-xl border-2 border-borda bg-creme px-4 py-3 text-tinta placeholder:text-tinta-fraca focus:border-obra-400 focus:outline-none"
        />
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="email" class="font-titulo font-semibold text-tinta">
          E-mail <span class="text-tijolo-700" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          placeholder="seu@email.com"
          aria-describedby="ajuda-email"
          class="rounded-xl border-2 border-borda bg-creme px-4 py-3 text-tinta placeholder:text-tinta-fraca focus:border-obra-400 focus:outline-none"
        />
        <p id="ajuda-email" class="text-xs text-tinta-fraca">
          Só usamos pra responder você. Nada de lista de spam.
        </p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="assunto" class="font-titulo font-semibold text-tinta">
          Sobre o que é?
        </label>
        <select
          id="assunto"
          name="assunto"
          class="rounded-xl border-2 border-borda bg-creme px-4 py-3 text-tinta focus:border-obra-400 focus:outline-none"
        >
          {assuntos.map((assunto) => <option value={assunto}>{assunto}</option>)}
        </select>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="mensagem" class="font-titulo font-semibold text-tinta">
          Sua mensagem <span class="text-tijolo-700" aria-hidden="true">*</span>
        </label>
        <textarea
          id="mensagem"
          name="mensagem"
          required
          rows="6"
          placeholder="Conta pra gente o que tá acontecendo..."
          class="resize-y rounded-xl border-2 border-borda bg-creme px-4 py-3 text-tinta placeholder:text-tinta-fraca focus:border-obra-400 focus:outline-none"
        ></textarea>
      </div>

      <p class="text-xs text-tinta-fraca">
        <span class="text-tijolo-700" aria-hidden="true">*</span> Campos
        obrigatórios.
      </p>

      <button
        type="submit"
        class="rounded-xl bg-obra-500 px-6 py-3.5 font-titulo text-lg font-semibold text-tinta transition-transform hover:scale-[1.01] hover:bg-obra-400 active:scale-100"
      >
        Enviar mensagem
      </button>

      <p
        data-contato-ok
        hidden
        role="status"
        class="rounded-xl bg-menta-500/15 p-4 text-sm font-bold text-menta-700"
      >
        Formulário preenchido certinho! Assim que ligarmos o envio, mensagens
        como essa chegam direto na nossa caixa. 🧡
      </p>
    </form>

    <div class="mt-8 rounded-2xl border-2 border-borda bg-papel p-6">
      <h2 class="font-titulo text-xl font-semibold text-tinta">
        Prefere outro caminho?
      </h2>
      <p class="mt-2 text-tinta-suave">
        Escreve pra <strong>contato@crescendonaobra.com.br</strong> (placeholder
        — troque pelo e-mail real). A gente costuma responder em até 3 dias
        úteis.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  // Enquanto não há backend: valida no navegador e mostra o retorno.
  const form = document.querySelector<HTMLFormElement>('form[data-contato]');
  form?.addEventListener('submit', (evento) => {
    evento.preventDefault();
    const aviso = form.querySelector<HTMLElement>('[data-contato-ok]');
    if (aviso) {
      aviso.hidden = false;
      aviso.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    form.reset();
  });
</script>
