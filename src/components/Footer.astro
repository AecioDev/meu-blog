---
import { Icon } from 'astro-icon/components';
import { SITE_TITLE, SITE_TAGLINE, MENU_PRINCIPAL } from '../consts';
import { ICONE_ALERTA } from '../utils/icones';
const ano = new Date().getFullYear();
---

<footer class="mt-16 bg-tinta text-creme">
  <div class="mx-auto max-w-6xl px-4 py-12 lg:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <div class="flex items-center gap-3">
          <svg
            aria-hidden="true"
            width="40"
            height="40"
            viewBox="0 0 64 64"
            fill="none"
            class="shrink-0"
          >
            <path
              d="M16 44 A16 28 0 0 1 48 44"
              class="stroke-tinta-fraca"
              stroke-width="2"
              stroke-linecap="round"
            />
            <line x1="10" y1="44" x2="54" y2="44" class="stroke-tinta-fraca" stroke-width="2" stroke-linecap="round" />
            <line x1="32" y1="44" x2="32" y2="18" class="stroke-tinta-fraca" stroke-width="2" stroke-linecap="round" />
            <rect x="20" y="30" width="6" height="14" rx="1.5" class="fill-papel" />
            <rect x="29" y="24" width="6" height="20" rx="1.5" class="fill-papel" />
            <rect x="38" y="14" width="6" height="30" rx="1.5" class="fill-obra-300" />
          </svg>
          <p class="font-titulo text-2xl font-bold text-obra-300">{SITE_TITLE}</p>
        </div>
        <p class="mt-3 max-w-xs text-sm text-creme/70">{SITE_TAGLINE}</p>
        <p class="mt-4 max-w-xs text-sm text-creme/70">
          A gente escreve pra quem tá aprendendo agora. Sem termo difícil, sem
          julgamento — só o passo a passo.
        </p>
      </div>

      <nav aria-label="Links do rodapé">
        <h2 class="font-titulo text-lg font-semibold text-creme">Navegue</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          {
            MENU_PRINCIPAL.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-creme/75 underline-offset-4 hover:text-obra-300 hover:underline"
                >
                  {item.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="font-titulo text-lg font-semibold text-creme">Acompanhe</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          <li>
            <a
              href="/rss.xml"
              class="text-creme/75 underline-offset-4 hover:text-obra-300 hover:underline"
              >Feed RSS</a
            >
          </li>
          <li>
            <a
              href="/sitemap-index.xml"
              class="text-creme/75 underline-offset-4 hover:text-obra-300 hover:underline"
              >Mapa do site</a
            >
          </li>
          <li>
            <a
              href="/contato/"
              class="text-creme/75 underline-offset-4 hover:text-obra-300 hover:underline"
              >Fala com a gente</a
            >
          </li>
        </ul>
        <p class="mt-5 flex items-start gap-1.5 rounded-2xl bg-creme/10 p-3 text-xs text-creme/70">
          <Icon name={ICONE_ALERTA} class="icone-linha mt-0.5 shrink-0" aria-hidden="true" />
          Conteúdo educativo. Serviço de gás, quadro de energia e estrutura:
          chame um profissional habilitado.
        </p>
      </div>
    </div>

    <p class="mt-10 border-t border-creme/15 pt-6 text-center text-sm text-creme/60">
      © {ano} {SITE_TITLE}. Feito com carinho pra quem tá começando.
    </p>
  </div>
</footer>
