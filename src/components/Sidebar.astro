---
/**
 * Barra lateral do blog.
 *
 * Desktop: coluna fixa à direita, acompanhando a rolagem.
 * Celular: os mesmos blocos, empilhados abaixo do conteúdo — nada
 * fica escondido atrás de clique.
 *
 * Na home ela some no celular (`comSidebarMobile={false}` no layout),
 * porque lá os blocos entram direto no fluxo da página, em outra ordem.
 */
import CategoryList from './CategoryList.astro';
import MostViewed from './MostViewed.astro';
import RecentPosts from './RecentPosts.astro';
import AdSlot from './AdSlot.astro';
import Achados from './Achados.astro';
import NewsletterBox from './NewsletterBox.astro';

interface Props {
  /** Post aberto no momento — some da lista de recentes. */
  postAtualId?: string;
  class?: string;
}

const { postAtualId, class: classe = '' } = Astro.props;
---

<aside
  class:list={['lg:sticky lg:top-24', classe]}
  aria-label="Conteúdo complementar"
>
  <div class="flex flex-col gap-5">
    <div class="rounded-2xl border-2 border-borda bg-papel p-5">
      <CategoryList />
    </div>

    <div class="rounded-2xl border-2 border-borda bg-papel p-5">
      <MostViewed />
    </div>

    <div class="rounded-2xl border-2 border-borda bg-papel p-5">
      <Achados />
    </div>

    <AdSlot slotId="sidebar-topo" formato="retangulo" />

    <div class="rounded-2xl border-2 border-borda bg-papel p-5">
      <RecentPosts limite={4} excluirId={postAtualId} />
    </div>

    <NewsletterBox compacto />
  </div>
</aside>
