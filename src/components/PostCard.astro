---
import { Image } from 'astro:assets';
import type { Post } from '../utils/posts';
import {
  urlDoPost,
  urlDaCategoria,
  formatarData,
  estiloCategoria,
} from '../utils/posts';

interface Props {
  post: Post;
  /** Prioriza o carregamento da imagem (use nos primeiros cards da home). */
  prioritaria?: boolean;
  /** Nível do título dentro do card, pra manter a hierarquia da página. */
  nivelTitulo?: 2 | 3;
}

const { post, prioritaria = false, nivelTitulo = 3 } = Astro.props;
const Titulo = `h${nivelTitulo}` as 'h2' | 'h3';
const estilo = estiloCategoria(post.data.category);
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border-2 border-borda bg-papel transition-all hover:-translate-y-1 hover:border-obra-300 hover:shadow-lg"
>
  <a href={urlDoPost(post)} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <Image
      src={post.data.coverImage}
      alt=""
      width={640}
      height={360}
      loading={prioritaria ? 'eager' : 'lazy'}
      class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </a>

  <div class="flex flex-1 flex-col gap-2 p-5">
    <a
      href={urlDaCategoria(post.data.category)}
      class:list={[
        'w-fit rounded-full px-3 py-1 text-xs font-bold transition-opacity hover:opacity-85',
        estilo.chip,
      ]}
    >
      <span aria-hidden="true">{estilo.emoji}</span>
      {post.data.category}
    </a>

    <Titulo class="font-titulo text-lg font-semibold leading-snug">
      <a
        href={urlDoPost(post)}
        class="text-tinta transition-colors hover:text-tijolo-700"
      >
        {post.data.title}
      </a>
    </Titulo>

    <p class="line-clamp-3 text-sm text-tinta-suave">{post.data.description}</p>

    <time
      datetime={post.data.pubDate.toISOString()}
      class="mt-auto pt-2 text-xs text-tinta-fraca"
    >
      {formatarData(post.data.pubDate)}
    </time>
  </div>
</article>
