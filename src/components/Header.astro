---
import { SITE_TITLE, SITE_TAGLINE, MENU_PRINCIPAL } from '../consts';

const caminhoAtual = Astro.url.pathname;
const estaAtivo = (href: string) =>
  href === '/' ? caminhoAtual === '/' : caminhoAtual.startsWith(href);
---

<header class="sticky top-0 z-50 border-b-4 border-obra-400 bg-creme/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 lg:px-6">
    <a href="/" class="group flex items-center gap-3" aria-label={`${SITE_TITLE} — página inicial`}>
      <span
        class="flex h-11 w-11 shrink-0 items-end justify-center gap-[3px] rounded-2xl bg-obra-500 p-2 transition-transform group-hover:-rotate-6"
        aria-hidden="true"
      >
        <span class="h-3 w-1.5 rounded-full bg-creme"></span>
        <span class="h-5 w-1.5 rounded-full bg-creme"></span>
        <span class="h-7 w-1.5 rounded-full bg-creme"></span>
      </span>
      <span class="leading-tight">
        <span class="block font-titulo text-xl font-bold text-tinta sm:text-2xl">
          {SITE_TITLE}
        </span>
        <span class="hidden text-xs text-tinta-fraca sm:block">{SITE_TAGLINE}</span>
      </span>
    </a>

    <!-- Menu desktop -->
    <nav aria-label="Menu principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          MENU_PRINCIPAL.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={estaAtivo(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-3 py-2 text-sm font-bold transition-colors',
                  estaAtivo(item.href)
                    ? 'bg-obra-500 text-tinta'
                    : 'text-tinta-suave hover:bg-obra-100 hover:text-tinta',
                ]}
              >
                {item.titulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Menu mobile: <details> puro, sem JavaScript -->
    <details class="menu-mobile relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full bg-obra-500 px-4 py-2 font-titulo text-sm font-semibold text-tinta"
      >
        <span class="sr-only">Abrir menu</span>
        <span aria-hidden="true">Menu</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav
        aria-label="Menu principal (celular)"
        class="absolute right-0 mt-2 w-56 rounded-2xl border-2 border-borda bg-papel p-2 shadow-xl"
      >
        <ul class="flex flex-col">
          {
            MENU_PRINCIPAL.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={estaAtivo(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-xl px-3 py-2.5 text-sm font-bold',
                    estaAtivo(item.href)
                      ? 'bg-obra-100 text-tinta'
                      : 'text-tinta-suave hover:bg-creme-forte',
                  ]}
                >
                  {item.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Esconde o triângulo padrão do <summary> em todos os navegadores */
  .menu-mobile summary::-webkit-details-marker {
    display: none;
  }
</style>
