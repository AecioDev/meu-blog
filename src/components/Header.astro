---
import { SITE_TITLE, SITE_TAGLINE, MENU_PRINCIPAL } from '../consts';

const caminhoAtual = Astro.url.pathname;
const estaAtivo = (href: string) =>
  href === '/' ? caminhoAtual === '/' : caminhoAtual.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-borda bg-creme/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 lg:px-6">
    <a href="/" class="group flex items-center gap-3" aria-label={`${SITE_TITLE} — página inicial`}>
      <span
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-tinta"
        aria-hidden="true"
      >
        <svg width="34" height="34" viewBox="0 0 64 64" fill="none">
          <path
            d="M16 44 A16 28 0 0 1 48 44"
            class="stroke-tinta-fraca"
            stroke-width="2.4"
            stroke-linecap="round"
          />
          <line x1="10" y1="44" x2="54" y2="44" class="stroke-tinta-fraca" stroke-width="2.4" stroke-linecap="round" />
          <line x1="32" y1="44" x2="32" y2="18" class="stroke-tinta-fraca" stroke-width="2.4" stroke-linecap="round" />
          <rect x="20" y="30" width="6" height="14" rx="1.5" class="fill-papel" />
          <rect x="29" y="24" width="6" height="20" rx="1.5" class="fill-papel" />
          <rect x="38" y="14" width="6" height="30" rx="1.5" class="fill-obra-300" />
        </svg>
      </span>
      <span class="leading-tight">
        <span class="block font-titulo text-xl font-bold text-tinta sm:text-2xl">
          {SITE_TITLE}
        </span>
        <span class="hidden text-xs text-tinta-fraca sm:block">{SITE_TAGLINE}</span>
      </span>
    </a>

    <!-- Menu desktop -->
    <nav aria-label="Menu principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          MENU_PRINCIPAL.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={estaAtivo(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-2 text-sm font-semibold transition-colors',
                  estaAtivo(item.href)
                    ? 'bg-tinta text-papel'
                    : 'text-tinta-suave hover:bg-creme-forte hover:text-tinta',
                ]}
              >
                {item.titulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Menu mobile: <details> puro, sem JavaScript -->
    <details class="menu-mobile relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-lg bg-tinta px-4 py-2 font-titulo text-sm font-semibold text-papel"
      >
        <span class="sr-only">Abrir menu</span>
        <span aria-hidden="true">Menu</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav
        aria-label="Menu principal (celular)"
        class="absolute right-0 mt-2 w-56 rounded-xl border border-borda bg-papel p-2 shadow-xl"
      >
        <ul class="flex flex-col">
          {
            MENU_PRINCIPAL.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={estaAtivo(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-xl px-3 py-2.5 text-sm font-bold',
                    estaAtivo(item.href)
                      ? 'bg-obra-100 text-tinta'
                      : 'text-tinta-suave hover:bg-creme-forte',
                  ]}
                >
                  {item.titulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Esconde o triângulo padrão do <summary> em todos os navegadores */
  .menu-mobile summary::-webkit-details-marker {
    display: none;
  }
</style>
