---
/**
 * Bloco de produtos com link de afiliado.
 *
 * Os links vêm do catálogo do painel (`tools/painel/produtos-afiliados.json`),
 * que é a fonte única: cadastra-se o produto uma vez e todos os posts que o
 * citam passam a mostrar os botões. O post só guarda os slugs, no campo
 * `materiais` do frontmatter.
 *
 * Produto sem link nenhum, ou marcado como "não vale link" no painel,
 * simplesmente não aparece.
 */
import catalogo from '../../tools/painel/produtos-afiliados.json';

interface Props {
  /** Slugs do catálogo, vindos do frontmatter do post. */
  materiais?: string[];
}

const { materiais = [] } = Astro.props;

/** Mesma ordem do painel. */
const LOJAS = [
  { campo: 'linkAmazon', nome: 'Amazon' },
  { campo: 'linkMercadoLivre', nome: 'Mercado Livre' },
  { campo: 'linkShopee', nome: 'Shopee' },
] as const;

type Produto = {
  nome: string;
  linkAmazon?: string;
  linkMercadoLivre?: string;
  linkShopee?: string;
  ignorar?: boolean;
};

const registro = catalogo as Record<string, Produto>;

const itens = materiais
  .map((slug) => {
    const produto = registro[slug];
    if (!produto || produto.ignorar) return null;

    const lojas = LOJAS.map((loja) => ({
      nome: loja.nome,
      href: (produto[loja.campo] ?? '').trim(),
    })).filter((loja) => loja.href);

    return lojas.length ? { nome: produto.nome, lojas } : null;
  })
  .filter((item) => item !== null);
---

{
  itens.length > 0 && (
    <aside
      class="not-prose my-10 rounded-2xl border-2 border-borda bg-papel p-5 sm:p-6"
      aria-labelledby="titulo-onde-comprar"
    >
      <h2
        id="titulo-onde-comprar"
        class="font-titulo text-xl font-bold text-tinta"
      >
        <span aria-hidden="true">📦</span> Onde comprar
      </h2>
      <p class="mt-1 text-sm text-tinta-suave">
        Os itens desta lista, nas lojas que a gente confere.
      </p>

      <ul class="mt-4 flex flex-col gap-4">
        {itens.map((item) => (
          <li class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-borda pb-4 last:border-b-0 last:pb-0">
            <span class="min-w-[9rem] flex-1 font-bold text-tinta">
              {item.nome}
            </span>
            <span class="flex flex-wrap gap-2">
              {item.lojas.map((loja) => (
                <a
                  href={loja.href}
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  class="rounded-lg border-2 border-borda px-3 py-1.5 text-sm font-bold text-tinta-suave transition-colors hover:border-obra-400 hover:text-tinta"
                >
                  {loja.nome}
                </a>
              ))}
            </span>
          </li>
        ))}
      </ul>

      <p class="mt-4 border-t-2 border-dashed border-borda pt-3 text-xs text-tinta-fraca">
        Estes são links de afiliado: se você comprar por eles, o blog ganha uma
        pequena comissão — <strong>sem custo nenhum a mais pra você</strong>. A
        gente só indica o que usaria em casa.
      </p>
    </aside>
  )
}

<script>
  /**
   * O bloco é renderizado no fim do post e, se o texto tiver uma seção de
   * materiais, sobe para logo abaixo dela — que é onde a pessoa acabou de
   * ler o que precisa comprar.
   *
   * Não dá para inserir isso no servidor: o conteúdo do post é Markdown, e
   * no ponto em que o HTML estaria disponível para manipular as imagens
   * ainda são placeholders que o Astro só resolve depois. Sem JavaScript o
   * bloco fica no fim, que também é um lugar razoável.
   */
  const bloco = document.querySelector<HTMLElement>('[aria-labelledby="titulo-onde-comprar"]');
  const conteudo = document.querySelector('.conteudo-post');

  if (bloco && conteudo) {
    const TERMOS = ['vai precisar', 'voce precisa', 'você precisa', 'materiais', 'ferramentas'];

    const semAcento = (t: string) =>
      t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

    const titulo = [...conteudo.querySelectorAll('h2, h3')].find((h) =>
      TERMOS.some((termo) => semAcento(h.textContent || '').includes(semAcento(termo)))
    );

    if (titulo) {
      // desce até o fim da seção: para no próximo título de mesmo nível ou maior
      let ultimo: Element = titulo;
      let proximo = titulo.nextElementSibling;
      while (proximo && !/^H[1-3]$/.test(proximo.tagName)) {
        ultimo = proximo;
        proximo = proximo.nextElementSibling;
      }
      ultimo.after(bloco);
    }
  }
</script>
