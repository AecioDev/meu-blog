---
import { getCategorias, estiloCategoria } from '../utils/posts';

const categorias = await getCategorias();
const caminhoAtual = Astro.url.pathname;
---

<nav aria-labelledby="titulo-categorias">
  <h2 id="titulo-categorias" class="font-titulo text-lg font-semibold text-tinta">
    Categorias
  </h2>
  <ul class="mt-3 flex flex-col gap-1.5">
    {
      categorias.map((cat) => {
        const href = `/categoria/${cat.slug}/`;
        const ativa = caminhoAtual.startsWith(`/categoria/${cat.slug}`);
        const estilo = estiloCategoria(cat.nome);
        return (
          <li>
            <a
              href={href}
              aria-current={ativa ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between gap-2 rounded-xl px-3 py-2 text-sm font-bold transition-colors',
                ativa
                  ? 'bg-obra-100 text-tinta'
                  : 'text-tinta-suave hover:bg-creme-forte hover:text-tinta',
              ]}
            >
              <span class="flex items-center gap-2">
                <span aria-hidden="true">{estilo.emoji}</span>
                {cat.nome}
              </span>
              <span class="rounded-full bg-creme-forte px-2 py-0.5 text-xs font-bold text-tinta-suave">
                {cat.total}
                <span class="sr-only">
                  {cat.total === 1 ? ' post' : ' posts'}
                </span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
