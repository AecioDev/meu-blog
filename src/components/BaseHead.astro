---
/**
 * Todas as meta tags de SEO da página: title, description, canonical,
 * Open Graph, Twitter Card, favicon, fontes e RSS.
 */
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  OG_IMAGE_PADRAO,
  TWITTER_HANDLE,
} from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** URL da imagem de compartilhamento (capa do post, quando houver). */
  image?: string;
  imageAlt?: string;
  /** "website" na home e páginas fixas, "article" nos posts. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  /** Impede indexação (usado no 404). */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = OG_IMAGE_PADRAO,
  imageAlt = SITE_TITLE,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(image, Astro.site);
/** Na home mostramos só o nome do blog; nas demais, "Página | Blog". */
const tituloCompleto = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{tituloCompleto}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Ícones -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#f79009" />

<!-- RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:image" content={imagemAbsoluta} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{
  type === 'article' && publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}
{
  type === 'article' && modifiedTime && (
    <meta
      property="article:modified_time"
      content={modifiedTime.toISOString()}
    />
  )
}
{type === 'article' && author && <meta property="article:author" content={author} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={tituloCompleto} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imagemAbsoluta} />
<meta name="twitter:image:alt" content={imageAlt} />
{TWITTER_HANDLE && <meta name="twitter:site" content={TWITTER_HANDLE} />}

<!-- Fontes arredondadas do Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;1,400&display=swap"
/>
