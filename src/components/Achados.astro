---
/**
 * "Achados" — vitrine de produtos na barra lateral.
 *
 * Lê os produtos marcados como destaque no catálogo do painel
 * (`tools/painel/produtos-afiliados.json`), a mesma fonte que abastece o
 * bloco "Onde comprar" dentro dos posts. Marcar um produto lá faz ele
 * aparecer aqui em todas as páginas do site.
 *
 * Sem nenhum produto em destaque, o bloco não é renderizado.
 */
import catalogo from '../../tools/painel/produtos-afiliados.json';

interface Props {
  /** Quantos mostrar. Mais que quatro vira lista e ninguém lê. */
  limite?: number;
}

const { limite = 3 } = Astro.props;

const LOJAS = [
  { campo: 'linkAmazon', nome: 'Amazon' },
  { campo: 'linkMercadoLivre', nome: 'Mercado Livre' },
  { campo: 'linkShopee', nome: 'Shopee' },
] as const;

type Produto = {
  nome: string;
  chamada?: string;
  destaque?: boolean;
  ignorar?: boolean;
  linkAmazon?: string;
  linkMercadoLivre?: string;
  linkShopee?: string;
};

const registro = catalogo as Record<string, Produto>;

const achados = Object.values(registro)
  .filter((p) => p.destaque && !p.ignorar)
  .map((produto) => {
    const lojas = LOJAS.map((loja) => ({
      nome: loja.nome,
      href: (produto[loja.campo] ?? '').trim(),
    })).filter((loja) => loja.href);

    return lojas.length ? { ...produto, lojas } : null;
  })
  .filter((p) => p !== null)
  .slice(0, limite);
---

{
  achados.length > 0 && (
    <section aria-labelledby="titulo-achados">
      <h2
        id="titulo-achados"
        class="flex items-center gap-2 font-titulo text-lg font-semibold text-tinta"
      >
        <span aria-hidden="true">🔎</span>
        Achados
      </h2>
      <p class="mt-1 text-xs text-tinta-fraca">
        Coisas que a gente usaria em casa.
      </p>

      <ul class="mt-3 flex flex-col gap-3">
        {achados.map((item) => (
          <li class="rounded-xl border-2 border-borda bg-creme p-3">
            <p class="text-sm font-bold leading-snug text-tinta">{item.nome}</p>
            {item.chamada && (
              <p class="mt-0.5 text-xs text-tinta-suave">{item.chamada}</p>
            )}
            <div class="mt-2 flex flex-wrap gap-1.5">
              {item.lojas.map((loja) => (
                <a
                  href={loja.href}
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  class="rounded-lg bg-creme-forte px-2.5 py-1 text-xs font-bold text-tinta-suave transition-colors hover:bg-obra-100 hover:text-tinta"
                >
                  {loja.nome}
                </a>
              ))}
            </div>
          </li>
        ))}
      </ul>

      <p class="mt-3 text-[0.65rem] leading-snug text-tinta-fraca">
        Links de afiliado: comprando por aqui, o blog ganha uma comissão sem
        custo a mais pra você.
      </p>
    </section>
  )
}
