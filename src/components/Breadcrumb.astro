---
/**
 * Trilha de navegação + JSON-LD (BreadcrumbList) pro Google entender
 * a hierarquia das páginas.
 */
interface Item {
  titulo: string;
  href?: string;
}

interface Props {
  itens: Item[];
}

const { itens } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: itens.map((item, indice) => ({
    '@type': 'ListItem',
    position: indice + 1,
    name: item.titulo,
    ...(item.href ? { item: new URL(item.href, Astro.site).href } : {}),
  })),
};
---

<nav aria-label="Você está aqui" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-tinta-fraca">
    {
      itens.map((item, indice) => (
        <li class="flex items-center gap-2">
          {item.href ? (
            <a
              href={item.href}
              class="font-semibold underline-offset-4 hover:text-tijolo-700 hover:underline"
            >
              {item.titulo}
            </a>
          ) : (
            <span aria-current="page" class="text-tinta-suave">
              {item.titulo}
            </span>
          )}
          {indice < itens.length - 1 && <span aria-hidden="true">›</span>}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
